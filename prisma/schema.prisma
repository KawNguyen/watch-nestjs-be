generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model User {
  email        String        @unique
  password     String
  role         UserRole      @default(CUSTOMER)
  phone        String?
  gender       UserGender?
  firstName    String        @default("")
  lastName     String        @default("")
  avatar       String?
  otp          String?
  otpExpiry    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  id           String        @id @default(uuid())
  accessToken  String?
  cart         Cart?
  couponUsages CouponUsage[]
  favorites    Favorite[]
  orders       Order[]
  reviews      Review[]
  sessions     Session[]
  addresses    Address[]
  stockEntries StockEntry[]
}

model Address {
  id        String   @id @default(uuid())
  street    String?
  district  String?
  ward      String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Brand {
  slug      String?     @unique
  code      String      @unique @default(dbgenerated("concat('BR', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String      @unique @db.VarChar(100)
  country   String?     @db.VarChar(100)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  id        String      @id @default(uuid())
  watches   Watch[]
  image     BrandImage?

  @@index([name])
}

model BrandImage {
  id           String   @id @default(uuid())
  public_id    String   @unique
  brandId      String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  absolute_url String
  brand        Brand    @relation(fields: [brandId], references: [id])
}

model Material {
  slug      String?  @unique
  code      String   @unique @default(dbgenerated("concat('MT', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  watches   Watch[]

  @@index([name])
}

model BandMaterial {
  slug      String?  @unique
  code      String   @unique @default(dbgenerated("concat('BM', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  watches   Watch[]

  @@index([name])
}

model Movement {
  slug      String?  @unique
  code      String   @unique @default(dbgenerated("concat('MV', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  watches   Watch[]

  @@index([name])
}

model Watch {
  slug            String?       @unique
  code            String        @unique @default(dbgenerated("concat('W', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 9)))"))
  name            String        @db.VarChar(100)
  description     String?
  gender          WatchGender   @default(UNISEX)
  brandId         String
  materialId      String
  bandMaterialId  String
  movementId      String
  diameter        Float?
  waterResistance Int?
  warranty        Int           @default(24)
  videoUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  id              String        @id @default(uuid())
  price           Float
  cartItems       CartItem[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  images          WatchImages[]
  reviews         Review[]
  stockItems      StockItem[]
  bandMaterial    BandMaterial  @relation(fields: [bandMaterialId], references: [id])
  brand           Brand         @relation(fields: [brandId], references: [id])
  material        Material      @relation(fields: [materialId], references: [id])
  movement        Movement      @relation(fields: [movementId], references: [id])
  inventory       Inventory?
}

model Favorite {
  userId    String
  watchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  watch     Watch    @relation(fields: [watchId], references: [id])

  @@unique([userId, watchId])
  @@index([userId])
  @@index([watchId])
}

model WatchImages {
  id           String   @id @default(uuid())
  public_id    String   @unique
  watchId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  absolute_url String
  watch        Watch    @relation(fields: [watchId], references: [id])
}

model Cart {
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
}

model CartItem {
  cartId    String
  watchId   String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id])
  watch     Watch    @relation(fields: [watchId], references: [id])
}

model StockEntry {
  addedById  String
  totalPrice Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  id         String      @id @default(uuid())
  addedBy    User        @relation(fields: [addedById], references: [id])
  stockItems StockItem[]
}

model StockItem {
  stockEntryId String
  watchId      String
  quantity     Int        @default(1)
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  id           String     @id @default(uuid())
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
  watch        Watch      @relation(fields: [watchId], references: [id])
}

model Order {
  userId             String
  addressId          String?
  totalPrice         Float
  status             OrderStatus   @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  couponId           String?
  id                 String        @id @default(uuid())
  orginalPrice       Float
  paymentMethod      PaymentMethod @default(COD)
  shippingNotes      String?
  cancellationReason String?
  address            Address?      @relation(fields: [addressId], references: [id])
  coupon             Coupon?       @relation(fields: [couponId], references: [id])
  user               User          @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
}

model OrderItem {
  orderId   String
  watchId   String
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  watch     Watch    @relation(fields: [watchId], references: [id])
}

model Inventory {
  id        String   @id @default(uuid())
  watchId   String   @unique
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watch     Watch    @relation(fields: [watchId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  watchId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  watch     Watch    @relation(fields: [watchId], references: [id])

  @@index([userId])
  @@index([watchId])
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String?
  discountType  String
  discountValue Float
  minOrderValue Float?
  count         Int?
  usedCount     Int           @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  couponUsage   CouponUsage[]
  orders        Order[]
}

model Advertisement {
  id        String   @id @default(uuid())
  title     String
  content   String?
  imageUrl  String?
  link      String?
  isActive  Boolean  @default(true)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponUsage {
  id       String   @id @default(uuid())
  userId   String
  couponId String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserGender {
  MALE
  FEMALE
}

enum WatchGender {
  MEN
  WOMEN
  UNISEX
}

enum PaymentMethod {
  COD
  MOMO
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}
