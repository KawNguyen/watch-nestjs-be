generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PendingUser {
  email     String   @id
  password  String
  firstName String
  lastName  String
  otp       String
  otpExpiry DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  role         UserRole       @default(CUSTOMER)
  phone        String?
  firstName    String         @default("")
  lastName     String         @default("")
  avatar       Json?
  otp          String?
  otpExpiry    DateTime?
  accessToken  String?
  cart         Cart?
  couponUsages CouponUsage[]
  favorites    Favorite[]
  orders       Order[]
  reviews      Review[]
  sessions     Session[]
  addresses    Address[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  StockEntry   StockEntry[]
  Notification Notification[]
  Blog         Blog[]
}

model Address {
  id        String    @id @default(uuid())
  street    String?
  district  String?
  ward      String?
  city      String?
  country   String?
  orders    Order[]
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Brand {
  id        String      @id @default(uuid())
  slug      String?     @unique
  code      String      @unique @default(dbgenerated("concat('BR', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String      @unique @db.VarChar(100)
  country   String?     @db.VarChar(100)
  watches   Watch[]
  image     BrandImage?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model BrandImage {
  id           String    @id @default(uuid())
  public_id    String    @unique
  absolute_url String
  brandId      String    @unique
  brand        Brand     @relation(fields: [brandId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Material {
  id        String    @id @default(uuid())
  slug      String?   @unique
  code      String    @unique @default(dbgenerated("concat('MT', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String    @unique
  watches   Watch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model BandMaterial {
  id        String    @id @default(uuid())
  slug      String?   @unique
  code      String    @unique @default(dbgenerated("concat('BM', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String    @unique
  watches   Watch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Movement {
  id        String    @id @default(uuid())
  slug      String?   @unique
  code      String    @unique @default(dbgenerated("concat('MV', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String    @unique
  watches   Watch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

model Watch {
  id              String          @id @default(uuid())
  slug            String?         @unique
  code            String          @unique @default(dbgenerated("concat('W', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 9)))"))
  name            String          @db.VarChar(100)
  description     String?
  gender          WatchGender     @default(UNISEX)
  brandId         String
  materialId      String
  bandMaterialId  String
  movementId      String
  diameter        Float?
  waterResistance Int?
  warranty        Int             @default(24)
  videoUrl        String?
  price           Float
  cartItems       CartItem[]
  favorites       Favorite[]
  orderItems      OrderItem[]
  images          WatchImage[]
  reviews         Review[]
  stockItems      StockItem[]
  bandMaterial    BandMaterial    @relation(fields: [bandMaterialId], references: [id])
  brand           Brand           @relation(fields: [brandId], references: [id])
  material        Material        @relation(fields: [materialId], references: [id])
  movement        Movement        @relation(fields: [movementId], references: [id])
  inventory       WatchInventory?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model WatchImage {
  id           String    @id @default(uuid())
  public_id    String    @unique
  absolute_url String
  watchId      String
  watch        Watch     @relation(fields: [watchId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model WatchInventory {
  id                String    @id @default(uuid())
  quantity          Int       @default(0)
  lowStockThreshold Int       @default(5) // Threshold for low stock alerts
  watchId           String    @unique
  watch             Watch     @relation(fields: [watchId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@map("watch_inventories")
}

model Favorite {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  watchId   String
  watch     Watch     @relation(fields: [watchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, watchId])
  @@index([userId, watchId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  cartItems CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
}

model CartItem {
  id        String    @id @default(uuid())
  quantity  Int       @default(1)
  cartId    String
  cart      Cart      @relation(fields: [cartId], references: [id])
  watchId   String
  watch     Watch     @relation(fields: [watchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model StockEntry {
  id         String      @id @default(uuid())
  entryCode  String      @unique @default(dbgenerated("concat('STE', upper(substring(replace(gen_random_uuid()::text, '-', ''), 1, 7)))"))
  totalPrice Float
  stockItems StockItem[]
  createdBy  String
  user       User        @relation(fields: [createdBy], references: [id])
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
}

model StockItem {
  id           String     @id @default(uuid())
  quantity     Int        @default(1)
  costPrice    Float
  stockEntryId String
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
  watchId      String
  watch        Watch      @relation(fields: [watchId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

model Order {
  id                 String         @id @default(uuid())
  totalPrice         Float
  status             OrderStatus    @default(PENDING)
  originalPrice       Float
  paymentMethod      PaymentMethod  @default(COD)
  shippingNotes      String?
  cancellationReason String?
  orderItems         OrderItem[]
  userId             String?
  user               User?          @relation(fields: [userId], references: [id])
  addressId          String?
  address            Address?       @relation(fields: [addressId], references: [id])
  couponId           String?
  walkinInformation  Json?
  coupon             Coupon?        @relation(fields: [couponId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  Notification       Notification[]
}

model OrderItem {
  id        String    @id @default(uuid())
  quantity  Int       @default(1)
  price     Float
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  watchId   String
  watch     Watch     @relation(fields: [watchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Review {
  id        String    @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  watchId   String
  watch     Watch     @relation(fields: [watchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([watchId])
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String?
  discountType  String
  discountValue Float
  minOrderValue Float?
  count         Int?
  usedCount     Int           @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  couponUsage   CouponUsage[]
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
}

model Advertisement {
  id        String    @id @default(uuid())
  title     String
  content   String?
  imageUrl  String?
  link      String?
  isActive  Boolean   @default(true)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CouponUsage {
  id       String   @id @default(uuid())
  userId   String
  couponId String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  orderId   String?
  message   String
  type      NotificationType @default(ORDER_UPDATE)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  thumbnail   String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
}

enum NotificationType {
  ORDER_CREATE
  ORDER_UPDATE
  ORDER_CANCELED
  NEW_PRODUCT
  PROMOTION
  LOW_STOCK
  ACCOUNT_UPDATE
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum WatchGender {
  MEN
  WOMEN
  UNISEX
}

enum PaymentMethod {
  COD
  MOMO
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELED
}
