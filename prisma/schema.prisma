generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  sessionId String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId])

  @@index([userId])
}

model User {
  email        String        @unique
  password     String
  role         UserRole      @default(CUSTOMER)
  otp          String?
  otpExpiry    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @id @default(uuid())
  sessions     Session[]
  accessToken  String?
  cart         Cart?
  couponUsages CouponUsage[]
  favorites    Favorite[]
  orders       Order[]
  profile      Profile?
  reviews      Review[]
  stockEntries StockEntry[]
}

model Profile {
  userId    String      @unique
  phone     String?
  gender    UserGender?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  profileId String      @id @default(uuid())
  firstName String      @default("")
  lastName  String      @default("")
  avatar    String?
  addresses Address[]
  user      User        @relation(fields: [userId], references: [userId])
}

model Address {
  id        String   @id @default(uuid())
  street    String?
  district  String?
  ward      String?
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [profileId])
  orders    Order[]
}

model Brand {
  slug      String?  @unique
  code      String   @unique @default(dbgenerated("concat('BR', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name      String   @unique @db.VarChar(100)
  country   String?  @db.VarChar(100)
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brandId   String   @id @default(uuid())
  watches   Watch[]

  @@index([name])
}

model Material {
  slug       String?  @unique
  code       String   @unique @default(dbgenerated("concat('MT', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  materialId String   @id @default(uuid())
  watches    Watch[]

  @@index([name])
}

model BandMaterial {
  slug           String?  @unique
  code           String   @unique @default(dbgenerated("concat('BM', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name           String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bandMaterialId String   @id @default(uuid())
  watches        Watch[]

  @@index([name])
}

model Movement {
  slug       String?  @unique
  code       String   @unique @default(dbgenerated("concat('MV', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 8)))"))
  name       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  movementId String   @id @default(uuid())
  watches    Watch[]

  @@index([name])
}

model Watch {
  slug            String?       @unique
  code            String        @unique @default(dbgenerated("concat('W', upper(\"substring\"(replace(((gen_random_uuid())::character varying)::text, '-'::text, ''::text), 1, 9)))"))
  name            String        @db.VarChar(100)
  description     String?
  gender          WatchGender   @default(UNISEX)
  brandId         String
  materialId      String?
  bandMaterialId  String?
  movementId      String?
  diameter        Float?
  waterResistance Int?
  warranty        Int           @default(24)
  videoUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  watchId         String        @id @default(uuid())
  cartItems       CartItem[]
  favorites       Favorite[]
  poster          Poster[]
  banner          Banner[]
  orderItems      OrderItem[]
  price           Price[]
  quantities      Quantity[]
  reviews         Review[]
  stockItems      StockItem[]
  bandMaterial    BandMaterial? @relation(fields: [bandMaterialId], references: [bandMaterialId])
  brand           Brand         @relation(fields: [brandId], references: [brandId])
  material        Material?     @relation(fields: [materialId], references: [materialId])
  movement        Movement?     @relation(fields: [movementId], references: [movementId])
}

model Quantity {
  watchId    String
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  quantityId String   @id @default(uuid())
  watch      Watch    @relation(fields: [watchId], references: [watchId])

  @@index([watchId])
}

model Favorite {
  userId     String
  watchId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  favoriteId String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [userId])
  watch      Watch    @relation(fields: [watchId], references: [watchId])

  @@unique([userId, watchId])
  @@index([userId])
  @@index([watchId])
}

model Poster {
  posterId  String   @id @default(uuid())
  url       String
  watchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watch     Watch    @relation(fields: [watchId], references: [watchId])
}

model Banner {
  bannerId  String   @id @default(uuid())
  url       String
  watchId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watch     Watch    @relation(fields: [watchId], references: [watchId])
}

model Cart {
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartId    String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [userId])
  items     CartItem[]
}

model CartItem {
  cartId     String
  watchId    String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cartItemid String   @id @default(uuid())
  cart       Cart     @relation(fields: [cartId], references: [cartId])
  watch      Watch    @relation(fields: [watchId], references: [watchId])
}

model StockEntry {
  addedById    String
  totalPrice   Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  stockEntryId String      @id @default(uuid())
  addedBy      User        @relation(fields: [addedById], references: [userId])
  items        StockItem[]
}

model StockItem {
  stockEntryId String
  watchId      String
  quantity     Int        @default(1)
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  stockItemId  String     @id @default(uuid())
  stockEntry   StockEntry @relation(fields: [stockEntryId], references: [stockEntryId])
  watch        Watch      @relation(fields: [watchId], references: [watchId])
}

model Order {
  userId        String
  addressId     String?
  totalPrice    Float
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  couponId      String?
  orderId       String        @id @default(uuid())
  orginalPrice  Float
  paymentMethod PaymentMethod @default(COD)
  shippingNotes String?
  address       Address?      @relation(fields: [addressId], references: [id])
  coupon        Coupon?       @relation(fields: [couponId], references: [couponId])
  user          User          @relation(fields: [userId], references: [userId])
  items         OrderItem[]
}

model OrderItem {
  orderId     String
  watchId     String
  quantity    Int      @default(1)
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItemId String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [orderId])
  watch       Watch    @relation(fields: [watchId], references: [watchId])
}

model Price {
  watchId   String
  value     Float
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  priceId   String    @id @default(uuid())
  watch     Watch     @relation(fields: [watchId], references: [watchId])

  @@index([watchId])
}

model Review {
  reviewId  String   @id @default(uuid())
  userId    String
  watchId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId])
  watch     Watch    @relation(fields: [watchId], references: [watchId])

  @@index([userId])
  @@index([watchId])
}

model Coupon {
  couponId      String        @id @default(uuid())
  code          String        @unique
  description   String?
  discountType  String
  discountValue Float
  minOrderValue Float?
  count         Int?
  usedCount     Int           @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  couponUsage   CouponUsage[]
  orders        Order[]
}

model Ads {
  adsId     String   @id @default(uuid())
  title     String
  content   String?
  imageUrl  String?
  link      String?
  isActive  Boolean  @default(true)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponUsage {
  couponUsageId String   @id @default(uuid())
  userId        String
  couponId      String
  usedAt        DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [couponId])
  user          User     @relation(fields: [userId], references: [userId])

  @@unique([userId, couponId])
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserGender {
  MALE
  FEMALE
}

enum WatchGender {
  MEN
  WOMEN
  UNISEX
}

enum PaymentMethod {
  COD
  MOMO
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}
